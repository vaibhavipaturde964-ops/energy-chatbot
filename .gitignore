# ============================================================
# EcoBot — .gitignore
# ============================================================

# ----- Secrets & credentials (NEVER commit these) ----------
.env
.env.*
*.env
.streamlit/secrets.toml
secrets.toml

# ----- Virtual environments --------------------------------
.venv/
venv/
env/
ENV/

# ----- Python cache ----------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.Python

# ----- Distribution / packaging ----------------------------
dist/
build/
*.egg-info/
*.egg
wheels/

# ----- Jupyter ---------------------------------------------
.ipynb_checkpoints/
*.ipynb

# ----- OS files --------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
*.swp
*.swo
*~

# ----- IDE -------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ----- Logs & temp files -----------------------------------
*.log
*.tmp
*.bak
*.orig

# ----- Test / coverage artifacts ---------------------------
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ----- Type checking ---------------------------------------
.mypy_cache/
.dmypy.json

# ----- HuggingFace model cache (large, re-downloadable) ----
.cache/
~/.cache/huggingface/

# ============================================================
# Intentionally TRACKED in git:
#   vector_db/      — ChromaDB index (needed for deployment)
#   bg.png          — UI background asset
#   logo.png        — UI logo asset
# ============================================================
