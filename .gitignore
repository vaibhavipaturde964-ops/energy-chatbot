# ============================================================
# EcoBot — .gitignore
# ============================================================

# ----- Secrets & credentials (NEVER commit these) ----------
.env
.env.*
*.env
!.env.example
.streamlit/secrets.toml
secrets.toml

# ----- Virtual environments --------------------------------
.venv/
venv/
env/
ENV/

# ----- Python cache ----------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.Python

# ----- Distribution / packaging ----------------------------
dist/
build/
*.egg-info/
*.egg
wheels/

# ----- Jupyter ---------------------------------------------
.ipynb_checkpoints/
*.ipynb

# ----- OS files --------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
*.swp
*.swo
*~

# ----- IDE -------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ----- Logs & temp files -----------------------------------
*.log
*.tmp
*.bak
*.orig

# ----- Test / coverage artifacts ---------------------------
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ----- Type checking ---------------------------------------
.mypy_cache/
.dmypy.json

# ----- HuggingFace model cache (large, re-downloadable) ----
.cache/
~/.cache/huggingface/

# ----- Large raw data files (exceed GitHub's 100 MB limit) -
# These are source/input data files. Download separately if needed.
data/raw/daily_dataset.csv

# ----- Node / frontend build artifacts ---------------------
node_modules/
frontend/node_modules/
.vercel/

# ============================================================
# Intentionally TRACKED in git:
#   vector_db/      — ChromaDB index (needed for Render deployment)
#   bg.png          — UI background asset
#   logo.png        — UI logo asset
#   data/raw/*      — all raw files EXCEPT daily_dataset.csv
#   backend/        — FastAPI backend for Render
#   frontend/       — static frontend for Vercel
# ============================================================
