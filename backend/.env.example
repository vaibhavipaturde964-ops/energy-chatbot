# EcoBot Backend — environment variables
# Copy to .env and fill in real values for local development.
# On Render, add these in the Environment Variables section of your service.
# NEVER commit .env to GitHub.

# Your Groq API key — https://console.groq.com/keys
GROQ_API_KEY=

# The deployed Vercel frontend URL (no trailing slash)
# Example: https://ecoboapp.vercel.app
FRONTEND_URL=http://localhost:3000
